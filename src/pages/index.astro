---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import ReactGallery from "../components/gallery/ReactGallery";
import SiteIcon from "../components/layout/SiteIcon";
import FooterStats from "../components/layout/FooterStats";
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";

import { marked } from "marked";

// Fetch photos from local portfolio collection
const photos = await getCollection("portfolio");

// Fetch site about content
const siteEntries = await getCollection("site");
const aboutEntry = siteEntries.find(e => e.id === "about");
const footerEntry = siteEntries.find(e => e.id === "footer");
const { Content: AboutContent } = aboutEntry ? await render(aboutEntry) : { Content: null };
const { Content: FooterContent } = footerEntry ? await render(footerEntry) : { Content: null };

// Fetch album info
const albumsInfo = await getCollection("albums");
const renderedAlbumDocs: Record<string, string> = {};

for (const album of albumsInfo) {
    // Astro's glob loader slugifies IDs: "San Diego Safari.md" -> "san-diego-safari"
    // We store by the slug so ReactGallery can look up by slugified folder name too
    const slug = album.id.replace(/\.md$/, "");
    renderedAlbumDocs[slug] = await marked.parse(album.body || "");
}

// Group photos by folder (album) instead of year
const groupedPhotos: Record<string, typeof photos> = {};

photos.forEach((photo) => {
	// e.g. "San Diego Zoo/PIC.jpg" -> "San Diego Zoo"
	const folderParts = photo.id.split("/");
	const folderRaw = folderParts.length > 1 ? folderParts[0] : "Ungrouped";
	const folder = folderRaw.replace(/-/g, ' ');

	if (!groupedPhotos[folder]) {
		groupedPhotos[folder] = [];
	}
	groupedPhotos[folder].push(photo);
});

// Function to get the latest date in a folder
const getFolderDate = (folder: string) => {
	const dates = groupedPhotos[folder].map(p => p.data.date ? new Date(p.data.date).getTime() : 0);
	return Math.max(...dates);
};

// Sort folders chronologically (newest first)
const sortedFolders = Object.keys(groupedPhotos).sort((a, b) => {
	if (a === "Ungrouped") return 1;
	if (b === "Ungrouped") return -1;
	return getFolderDate(b) - getFolderDate(a);
});

// Sort photos within folders (newest first)
sortedFolders.forEach((folder) => {
	groupedPhotos[folder].sort(
		(a, b) => {
            const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
            const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
            return dateB - dateA;
        }
	);
});

// Calculate last upload date from all photos
const allDates = photos
	.map(p => p.data.date ? new Date(p.data.date).getTime() : 0)
	.filter(d => d > 0);
const lastUploadDate = allDates.length > 0 
	? new Date(Math.max(...allDates)).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
	: 'Unknown';

// Pre-optimize images for ReactGallery to work correctly on Cloudflare Pages
const optimizedGroupedPhotos: Record<string, any[]> = {};
for (const folder of sortedFolders) {
    optimizedGroupedPhotos[folder] = await Promise.all(
        groupedPhotos[folder].map(async (photo) => {
            const thumbnail = await getImage({ src: photo.data.image, width: 1200, format: 'avif', quality: 85 });
            const full = await getImage({ src: photo.data.image, width: 3000, format: 'avif', quality: 95 });
            
            // Exclude 'body' to prevent it from being serialized into the initial HTML island props
            const { body, ...restOfPhoto } = photo;
            
            return {
                ...restOfPhoto,
                thumbnailUrl: thumbnail.src,
                fullUrl: full.src,
            };
        })
    );
}

const generateCollectionId = (folderName: string) => {
	// Split by space or special characters
	const words = folderName.split(/[\s_-]+/);

	if (words.length === 1) {
		return folderName.substring(0, 3).toUpperCase();
	}

	// Initials
	let initials = words
		.map((w) => w[0])
		.join("")
		.toUpperCase();

	// If only 2 letters, maybe different logic? User asked for Distinct.
	// E.g. San Diego -> SD. San Diego Zoo -> SDZ.
	return initials;
};
---

<Layout 
	title="Anish Photography — Visual Archive"
	description={`${photos.length} photographs across ${sortedFolders.length} collections · Latest: ${(sortedFolders[0] || 'Archive').replace(/-/g, ' ').split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')}`}
>
	<div
		class="flex flex-col min-h-screen w-full bg-[var(--color-surface)] text-[var(--color-on-surface-variant)]"
	>
		{/* Main Content */}
		<main class="flex-1 w-full bg-[var(--color-surface)]">
		{/* Hero Section */}
		<section class="bg-[var(--color-surface-container-low)] w-full relative z-10">
			<div class="pt-12 pb-20 lg:pt-20 lg:pb-28 px-4 lg:px-12 w-full max-w-4xl mx-auto">
				{/* Site Icon */}
				<div class="flex justify-start mb-4">
					<SiteIcon client:load className="w-10 h-10 md:w-12 md:h-12" />
				</div>

				{/* Header */}
				<h1 class="font-heading text-xl md:text-2xl text-white tracking-tight mb-3" style="font-weight: 450;">
					{aboutEntry ? aboutEntry.data.title : 'Visual Archive'}
				</h1>

				{/* Stats Sentence */}
				<p class="font-mono text-[11px] md:text-xs text-[var(--color-on-surface-variant)] mb-6">
					{photos.length} exposures across {sortedFolders.length} collections, last updated {lastUploadDate}.
				</p>

				{/* Description */}
				{AboutContent && (
					<div class="markdown-content text-sm md:text-base text-[var(--color-on-surface-variant)] leading-relaxed max-w-xl">
						<AboutContent />
					</div>
				)}
			</div>
		</section>

		{/* Gradient Transition */}
		<div class="w-full h-32 bg-gradient-to-b from-[var(--color-surface-container-low)] to-[var(--color-surface)] relative z-0"></div>

		{/* Gallery Container with Negative Margin Overlap */}
		<div class="p-4 lg:p-12 w-full relative z-20 -mt-24 lg:-mt-32">
			{
				Object.keys(groupedPhotos).length === 0 ? (
					<div class="text-center py-20">
						<p class="text-neutral-500 font-mono">
							NO_DATA_AVAILABLE // UPLOAD_TO_R2
						</p>
					</div>
				) : (
                    <ReactGallery 
                        client:load 
                        groupedPhotos={optimizedGroupedPhotos} 
                        sortedFolders={sortedFolders} 
                        albumHtml={renderedAlbumDocs}
                    />
				)
			}
			</div>

		{/* Footer */}
		<footer class="bg-[var(--color-surface-container-low)] w-full relative z-10 mt-8">
			{/* Gradient Transition into footer */}
			<div class="w-full h-32 bg-gradient-to-b from-[var(--color-surface)] to-[var(--color-surface-container-low)] relative z-0 -mb-1"></div>
			<div class="pt-12 pb-20 lg:pt-16 lg:pb-28 px-4 lg:px-12 w-full max-w-4xl mx-auto">
				{/* Session Stats */}
				<FooterStats
					client:load
					totalPhotos={photos.length}
					totalCollections={sortedFolders.length}
				/>

				{/* Footer text */}
				{FooterContent && (
					<div class="markdown-content text-sm md:text-base text-[var(--color-on-surface-variant)] leading-relaxed max-w-xl mt-6 mb-10">
						<FooterContent />
					</div>
				)}

				{/* Back to top */}
				<button
					id="back-to-top"
					class="group flex items-center gap-3 cursor-pointer bg-transparent"
				>
					<span class="text-[11px] font-mono tracking-widest text-[var(--color-on-surface)] opacity-30 group-hover:opacity-70 transition-opacity">
						↑ back to top
					</span>
				</button>

				{/* Bottom rule */}
				<p class="font-mono text-[10px] text-[var(--color-on-surface-variant)] opacity-20 mt-12">
					© {new Date().getFullYear()} Anish Govind — All rights reserved
				</p>
			</div>
		</footer>

		</main>

	</div>

	<script>
		import { WebHaptics } from "web-haptics";
		const haptics = new WebHaptics();

		// Back to top
		document.getElementById("back-to-top")?.addEventListener("click", () => {
			(window as any).haptics?.trigger("light");
			window.scrollTo({ top: 0, behavior: "smooth" });
		});


		// Intersection Observer for Active State
		const sections = document.querySelectorAll(".section-folder");
		const navLinks = document.querySelectorAll(".nav-link");
		const pill = document.getElementById("active-pill");

		const observerOptions = {
			root: null,
			rootMargin: "-25% 0px -50% 0px", // Adjusted for mobile sticky header
			threshold: 0,
		};

		let activeSectionId: string | null = null;

		const observer = new IntersectionObserver((entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					const id = entry.target.id;

					if (activeSectionId && activeSectionId !== id) {
						haptics.trigger("heavy");
					}
					activeSectionId = id;

					// Update URL hash to reflect the current section,
					// but only when FocusView is not open (it manages its own hash)
					const isPhotoOpen = document.body.style.overflow === 'hidden';
					if (!isPhotoOpen) {
						history.replaceState(null, "", `#${id}`);
					}

					// Reset and activate all links pointing to this target (mobile + desktop)
					navLinks.forEach((link) => {
						const target = link.getAttribute("data-target");
						if (target === id) {
							link.classList.remove("text-neutral-500");
							link.classList.add("text-white");
						} else {
							link.classList.remove("text-white");
							link.classList.add("text-neutral-500");
						}
					});

					// Handle Pillar Indicator (Desktop Only)
					const desktopActiveLink = document.querySelector(
						`nav.lg\\:flex .nav-link[data-target="${id}"]`,
					) as HTMLElement;

					if (desktopActiveLink && pill && pill.offsetParent) {
						const container = pill.offsetParent as HTMLElement;
						const linkRect =
							desktopActiveLink.getBoundingClientRect();
						const containerRect = container.getBoundingClientRect();
						const relativeTop = linkRect.top - containerRect.top;
						const linkHeight = desktopActiveLink.offsetHeight;

						const targetHeight = 16;
						const offset = (linkHeight - targetHeight) / 2;

						pill.style.opacity = "1";
						pill.style.top = `${relativeTop + offset}px`;
						pill.style.height = `${targetHeight}px`;
					}
				}
			});
		}, observerOptions);

		sections.forEach((section) => {
			observer.observe(section);
		});
	</script>
</Layout>
